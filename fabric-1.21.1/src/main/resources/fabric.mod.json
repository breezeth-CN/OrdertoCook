	"depends": {
		"fabricloader": ">=0.18.2",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*",
		"geckolib": ">=4.8.4"
	},
	"suggests": {
		"another-mod": "*",
		"jade": "*"
