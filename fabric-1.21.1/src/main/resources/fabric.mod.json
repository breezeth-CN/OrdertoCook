{
	"schemaVersion": 1,
	"id": "ordertocook",
	"version": "${version}",
	"name": "下单了",
	"description": "通过接取外卖订单、到店食物订单，制作并交付来获取奖励；包含等级成长、概率加成、加急订单等玩法机制",
	"authors": [
		"微风breezeth"
	],
	"contributors": [
		"Ao22333"
	],
	"contact": {
		"homepage": "https://space.bilibili.com/21676027",
		"issues": "https://www.mcmod.cn/class/25025.html）"
	},
	"license": "[GPL-3.0 license](https://github.com/breezeth-CN/OrdertoCook?tab=GPL-3.0-1-ov-file#)",
	"icon": "assets/ordertocook/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"cn.breezeth.ordertocook.OrderToCookMod"
		],
		"client": [
			"cn.breezeth.ordertocook.client.OrderToCookModClient"
		],
		"jade": [
			"cn.breezeth.ordertocook.compat.jade.OrderToCookJadePlugin"
